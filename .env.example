# Local / Docker Compose default (SQLite) -- leave unset for local runs.
# For Cloud Run + Cloud SQL, this becomes a Postgres connection string,
# injected via Secret Manager / Cloud Run environment variables, never
# committed to the repository.
DATABASE_URL=postgresql://faultservice:changeme@db:5432/faultservice

# Set to 1 to deliberately simulate the notification dependency failing
# (used for the recovery/degradation test case).
NOTIFY_FORCE_FAILURE=0

# Set to 1 to deliberately simulate the database being unavailable
# (used for the dependency/service-failure test case).
DB_FORCE_FAILURE=0

# Real notification channel -- both optional. Leave both unset to keep
# the zero-dependency stub (always succeeds, no external call made).
# If NOTIFY_EMAIL_API_KEY is set, email takes priority over the webhook
# below. Treat every value here as a secret: it must only ever live in
# a real .env file or a deployed secret store, never committed or
# pasted into a prompt.

# Sends a real email via the Resend API (https://resend.com) when the
# maintenance contact should actually receive something in their inbox.
# Get a free API key at resend.com, no domain verification needed if
# you keep NOTIFY_EMAIL_FROM at its default test sender address.
NOTIFY_EMAIL_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=onboarding@resend.dev

# Alternative: any webhook URL (Discord, Slack, n8n, or a generic JSON
# receiver), used only if NOTIFY_EMAIL_API_KEY is not set.
NOTIFY_WEBHOOK_URL=

# Payload shape for NOTIFY_WEBHOOK_URL: "generic" (default, a plain
# JSON object), "discord" (wraps the message in {"content": ...}), or
# "slack" (wraps it in {"text": ...}).
NOTIFY_WEBHOOK_FORMAT=generic

# Shared secret the maintenance team uses to update a ticket's status
# (PATCH /faults/{id}/status). Leave unset to disable status updates
# entirely -- there is no way to update a ticket's status if this is
# not set, by design, rather than defaulting to open. Generate a real
# value with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Treat it as a secret: anyone who has it can change any ticket's status.
MAINTENANCE_API_KEY=

# Base URL used to build the "view this ticket" link included in
# notification emails/webhooks. Defaults to the local address, which is
# correct for Docker Compose. Set this to the real Cloud Run URL if
# this is ever actually deployed there, so the link in the email points
# somewhere real instead of localhost. Not a secret.
APP_BASE_URL=http://localhost:8080
